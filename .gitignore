# =============================================================================
# IDE / Editor files (user-specific, NEVER commit these)
# =============================================================================
.qtcreator/
.directory
CMakeLists.txt.user
*.user
*.pro.user
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# Build artifacts (NEVER commit these)
# =============================================================================

# CMake / Qt / IDE build directories
build/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
Makefile

# Snapcraft build lifecycle directories (generated by `snapcraft`)
# - parts/   : source + build for each part defined in snapcraft.yaml
# - stage/   : files "staged" from parts (combined)
# - prime/   : final tree ready to be packed into the .snap
# - overlay/ : used by newer Snapcraft (core22/core24 + overlay feature / content snaps)
parts/
stage/
prime/
overlay/

# Built snap packages
*.snap

# Snapcraft internal state and local overrides
snap/.snapcraft/
snap/local/

# Other common generated files
*.o
*.so
*.a
*~
